{
  "name": "claude-adds",
  "version": "0.4.1",
  "private": true,
  "description": "Arabic desktop app for the tools you have across Claude, Claude Code, Codex, Gemini and Antigravity.",
  "author": "Sufyan Nasser",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "package": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.sufyanaser.claudeadds",
    "productName": "Claude Adds",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Claude-Adds-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "artifactName": "Claude-Adds-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Claude-Adds-${version}-setup.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sufyanaser/Claude-Adds.git"
  }
}
